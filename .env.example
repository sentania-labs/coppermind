# Coppermind runs without this file. Copy it to `.env` only to change one of
# the wiring values below; the product's own settings (folder names, intervals,
# limits) live in /data/state/settings.yaml with working defaults, not here.
#
#   cp .env.example .env

# Where the API is published on the host. Loopback remains the safe default
# even though every `/v1` route requires a scoped key. PostgreSQL is not
# published at all; reach it with
# `docker compose exec postgres psql -U coppermind`.
# COPPERMIND_API_BIND=127.0.0.1:8080

# Where Admin is published on the host. Its session cookie is always Secure,
# which a browser sends over HTTPS and on loopback only, so publishing Admin on
# any other address requires TLS in front of it. There is no plaintext option.
# Republishing Admin also puts its login in reach of anyone who can reach that
# port, and login has no attempt limiting yet.
# COPPERMIND_ADMIN_BIND=127.0.0.1:8082

# Log level for every Coppermind service: DEBUG, INFO, WARNING or ERROR.
# COPPERMIND_LOG_LEVEL=INFO

# Bring your own PostgreSQL instead of the bundled instance is supported by the
# services (COPPERMIND_DATABASE_URL and the COPPERMIND_DB_* values) but is not
# wired into this compose file yet. The URL must not contain a password. The
# credential comes from COPPERMIND_DB_PASSWORD_FILE. See STATUS.md.
# COPPERMIND_DATABASE_URL=postgresql://coppermind@db.example:5432/coppermind
# COPPERMIND_DB_PASSWORD_FILE=/run/coppermind/postgres/postgres-password
